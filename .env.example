# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional server-level Anthropic Claude API Key.
# Can also be configured directly at the user level in Settings > AI Configuration.
ANTHROPIC_API_KEY=""

# OPENAI_API_KEY: Optional server-level OpenAI API Key for GPT-4o / o1 / o3 models.
# Can also be configured directly at the user level in Settings > AI Configuration.
OPENAI_API_KEY=""

# DEEPSEEK_API_KEY: Optional server-level DeepSeek API Key.
DEEPSEEK_API_KEY=""

# FINNHUB_API_KEY: Required for real-time stock quotes.
# Get a free API key from https://finnhub.io/
FINNHUB_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
# The app uses SQLite by default, which is ephemeral in Cloud Run.
# To persist data across restarts, provide a MySQL connection string.
# Example: mysql://user:password@host:port/database
MYSQL_URL=""

# Google OAuth Configuration
# Get these from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SESSION_SECRET="your-random-session-secret"

# Resend API Key for sending emails (get one at https://resend.com)
RESEND_API_KEY=""
